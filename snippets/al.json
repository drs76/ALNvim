  "HttpClient GET Request": {
    "prefix": "thttpclient",
    "body": [
      "var",
      "\tClient: HttpClient;",
      "\tResponse: HttpResponseMessage;",
      "\tResponseText: Text;",
      "begin",
      "\tClient.Get('${1:https://api.example.com/endpoint}', Response);",
      "\tif Response.IsSuccessStatusCode then begin",
      "\t\tResponse.Content.ReadAs(ResponseText);",
      "\t\t$0",
      "\tend;",
      "end;"
    ],
    "description": "AL HttpClient GET request skeleton"
  },
  "JSON Object Parse": {
    "prefix": "tjsonparse",
    "body": [
      "var",
      "\tJObject: JsonObject;",
      "\tJToken: JsonToken;",
      "begin",
      "\tJObject.ReadFrom(${1:JsonText});",
      "\tif JObject.Get('${2:key}', JToken) then begin",
      "\t\t${3:Value} := JToken.AsValue().As${4|Text,Integer,Decimal,Boolean|}();",
      "\t\t$0",
      "\tend;",
      "end;"
    ],
    "description": "AL JSON object parse skeleton"
  }
