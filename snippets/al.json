{
  "Error Message": {
    "prefix": "terror",
    "body": [
      "error('${1:Error message: %1}', ${0:Variable});"
    ],
    "description": "AL Error with format string"
  },
  "Message": {
    "prefix": "tmessage",
    "body": [
      "Message('${1:Message: %1}', ${0:Variable});"
    ],
    "description": "AL Message with format string"
  },
  "Confirm Dialog": {
    "prefix": "tconfirm",
    "body": [
      "if not Confirm('${1:Are you sure?}', ${2:false}) then",
      "\texit;"
    ],
    "description": "AL Confirm dialog with exit guard"
  },
  "FindSet Loop": {
    "prefix": "tfindset",
    "body": [
      "if ${1:Rec}.FindSet() then begin",
      "\trepeat",
      "\t\t$0",
      "\tuntil ${1:Rec}.Next() = 0;",
      "end;"
    ],
    "description": "AL FindSet repeat loop"
  },
  "SetRange Filter": {
    "prefix": "tsetrange",
    "body": [
      "${1:Rec}.SetRange(${2:FieldName}, ${3:FromValue}, ${4:ToValue});"
    ],
    "description": "AL SetRange filter"
  },
